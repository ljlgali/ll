%% chat2.py 代码架构图（作业二：在 chat1 基础上新增 isLeapYear 工具）
%% 相对 chat1 的改动：tools +1、system 提示词追加、新增 is_leap_year 函数、分发分支 +elif
flowchart TD
    A["程序启动<br/>DELAY = 0.02"] --> B["读取 config.ini"]
    B --> C["创建 OpenAI 客户端"]
    C --> D["定义 tools 列表<br/>[getDate, isLeapYear]"]:::new
    D --> E["初始化 messages<br/>system 提示词追加闰年规则"]:::new
    E --> F{"while True<br/>外层：多轮对话循环"}
    F --> G["input 读取用户 prompt"]
    G --> H["messages.append<br/>role=user"]:::msg
    H --> I{"while True<br/>内层：工具调用循环"}
    I --> J["client.chat.completions.create<br/>stream=True, tools, tool_choice=auto"]
    J --> K["遍历 chunk 流式输出<br/>逐字符 print + sleep"]
    K --> L["累积 content -> reply<br/>累积 tool_calls -> calls"]
    L --> M{"calls 是否为空?"}
    M -->|"空"| N["messages.append<br/>role=assistant"]:::msg
    N --> F
    M -->|"非空"| O["messages.append<br/>role=assistant + tool_calls"]:::msg
    O --> P["遍历 calls<br/>json.loads(arguments)"]
    P --> Q["print LOG 调用工具"]
    Q --> R["工具分发"]
    R --> S["getDate"]
    R --> T["isLeapYear<br/>args['year']"]:::new
    R --> U["未知工具<br/>-> 错误信息"]
    S --> S1["get_current_time()"]
    S1 --> S2["subprocess.run<br/>date /t & time /t"]
    T --> T1["is_leap_year(year)<br/>纯 Python 计算"]:::new
    T1 --> T2{"year % 4 == 0 and year % 100 != 0<br/>or year % 400 == 0"}:::new
    T2 -->|"真"| T3["返回：是闰年 + 判断依据"]:::new
    T2 -->|"假"| T4["返回：不是闰年 + 判断依据"]:::new
    S2 --> V["工具结果字符串"]
    T3 --> V
    T4 --> V
    U --> V
    V --> W["messages.append<br/>role=tool + tool_call_id + content"]:::msg
    W --> I
    J -.->|"异常"| X["except: print Error"]
    X --> F

    classDef msg fill:#ffeeba,stroke:#d39e00,color:#000;
    classDef new fill:#d4edda,stroke:#28a745,color:#000;
