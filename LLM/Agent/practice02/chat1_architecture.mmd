%% chat1.py 代码架构图（作业一：新增 getDate 工具）
%% 流式打字机 + 无限循环 + 多轮对话历史 + 单工具调用
flowchart TD
    A["程序启动<br/>DELAY = 0.02"] --> B["读取 config.ini<br/>configparser.ConfigParser()"]
    B --> C["创建 OpenAI 客户端<br/>base_url / api_key"]
    C --> D["定义 tools 列表<br/>[getDate]"]
    D --> E["初始化 messages<br/>system 提示词"]:::msg
    E --> F{"while True<br/>外层：多轮对话循环"}
    F --> G["input 读取用户 prompt"]
    G --> H["messages.append<br/>role=user"]:::msg
    H --> I{"while True<br/>内层：工具调用循环"}
    I --> J["client.chat.completions.create<br/>stream=True, tools, tool_choice=auto"]
    J --> K["遍历 chunk 流式输出<br/>逐字符 print + time.sleep(DELAY)"]
    K --> L["累积 delta.content -> reply<br/>累积 delta.tool_calls -> calls"]
    L --> M{"calls 是否为空?"}
    M -->|"空：模型给出最终回答"| N["messages.append<br/>role=assistant"]:::msg
    N --> F
    M -->|"非空：需要调用工具"| O["messages.append<br/>role=assistant + tool_calls"]:::msg
    O --> P["遍历 calls<br/>json.loads 解析 arguments"]
    P --> Q["print LOG 调用工具"]
    Q --> R["工具分发"]
    R --> S["getDate<br/>-> get_current_time()"]
    R --> T["未知工具<br/>-> 错误信息"]
    S --> U["subprocess.run<br/>date /t & time /t"]
    U --> V["返回字符串结果"]
    T --> V
    V --> W["messages.append<br/>role=tool + tool_call_id + content"]:::msg
    W --> I
    J -.->|"异常"| X["except: print Error"]
    X --> F

    classDef msg fill:#ffeeba,stroke:#d39e00,color:#000;
