# Pet Hospital MCP 运行参数（被 src/pet_hospital_mcp/config.py 自动加载）
# 真实进程环境变量优先于此文件（override=False），所以部署时 set 系统环境变量即可覆盖。

# 上游 Go REST API 地址
PET_HOSPITAL_BASE_URL=http://127.0.0.1:8080

# MCP 服务监听地址 / 端口
# 默认仅本机访问；要允许局域网访问改 0.0.0.0
MCP_HOST=127.0.0.1
MCP_PORT=8000

# MCP JSON-RPC 端点路径
MCP_ENDPOINT_PATH=/mcp

# 上游请求超时（秒）
MCP_BACKEND_TIMEOUT=5.0

# 上游瞬态错误重试次数（0=不重试）
MCP_BACKEND_RETRIES=2
