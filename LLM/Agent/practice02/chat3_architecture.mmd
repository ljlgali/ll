%% chat3.py 代码架构图（作业三：在 chat2 基础上新增 10 个本地文件操作 function）
%% 共 12 个工具：getDate + isLeapYear + 10 个文件工具
flowchart TD
    A["程序启动<br/>DELAY=0.02 / TEXT_EXTS 白名单"]:::new --> B["读取 config.ini"]
    B --> C["创建 OpenAI 客户端"]
    C --> D["import os / shutil / mimetypes<br/>+ subprocess"]:::new
    D --> E["定义 tools 列表（12 个）<br/>getDate, isLeapYear, getCwd, listFiles, getFileType,<br/>readFile, createFile, editFile, createDir,<br/>deleteDir, deleteFile, renamePath"]:::new
    E --> F["初始化 messages<br/>system 提示词追加文件工具说明"]:::new
    F --> G{"while True<br/>外层：多轮对话循环"}
    G --> H["input 读取用户 prompt"]
    H --> I["messages.append role=user"]:::msg
    I --> J{"while True<br/>内层：工具调用循环"}
    J --> K["client.chat.completions.create<br/>stream=True, tools, tool_choice=auto"]
    K --> L["遍历 chunk 流式输出<br/>逐字符 print + sleep"]
    L --> M["累积 content -> reply<br/>累积 tool_calls -> calls"]
    M --> N{"calls 是否为空?"}
    N -->|"空"| O["messages.append role=assistant"]:::msg
    O --> G
    N -->|"非空"| P["messages.append<br/>role=assistant + tool_calls"]:::msg
    P --> Q["遍历 calls<br/>json.loads(arguments)"]
    Q --> R["print LOG 调用工具"]
    R --> S["工具分发 if/elif 链"]

    S --> S1["getDate -> get_current_time()"]
    S1 --> S1a["subprocess.run date /t & time /t"]

    S --> S2["isLeapYear -> is_leap_year(year)"]
    S2 --> S2a["纯 Python 取模判断闰年"]

    S --> S3["getCwd -> get_cwd()"]
    S3 --> S3a["os.getcwd()"]

    S --> S4["listFiles -> list_files(path)"]
    S4 --> S4a["os.path.isdir 校验<br/>os.listdir 分组排序"]

    S --> S5["getFileType -> get_file_type(path)"]
    S5 --> S5a["os.path.splitext 取扩展名<br/>mimetypes.guess_type 取 MIME<br/>TEXT_EXTS 判断是否纯文本"]:::new

    S --> S6["readFile -> read_file(path)"]
    S6 --> S6a["扩展名白名单校验<br/>open utf-8 读取<br/>处理 UnicodeDecodeError"]:::new

    S --> S7["createFile -> create_file(dir, filename, content)"]
    S7 --> S7a["目录存在校验<br/>文件已存在校验<br/>open w 写入"]:::new

    S --> S8["editFile -> edit_file(path, content, mode)"]
    S8 --> S8a["纯文本校验<br/>mode=overwrite 覆盖<br/>mode=append 追加"]:::new

    S --> S9["createDir -> create_dir(path)"]
    S9 --> S9a["os.makedirs 递归创建"]:::new

    S --> S10["deleteDir -> delete_dir(path)"]
    S10 --> S10a["os.walk 统计文件数<br/>shutil.rmtree 删除非空目录"]:::new

    S --> S11["deleteFile -> delete_file(path)"]
    S11 --> S11a["os.path.isfile 校验<br/>os.remove"]:::new

    S --> S12["renamePath -> rename_path(path, new_name)"]
    S12 --> S12a["保留原目录<br/>os.rename 重命名文件或目录"]:::new

    S --> S13["未知工具 -> 错误信息"]

    S1a --> T["工具结果字符串"]
    S2a --> T
    S3a --> T
    S4a --> T
    S5a --> T
    S6a --> T
    S7a --> T
    S8a --> T
    S9a --> T
    S10a --> T
    S11a --> T
    S12a --> T
    S13 --> T
    T --> U["messages.append<br/>role=tool + tool_call_id + content"]:::msg
    U --> J

    K -.->|"异常"| V["except: print Error"]
    V --> G

    classDef msg fill:#ffeeba,stroke:#d39e00,color:#000;
    classDef new fill:#d4edda,stroke:#28a745,color:#000;
